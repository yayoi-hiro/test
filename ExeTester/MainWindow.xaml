<Window x:Class="ExeTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExeTester"
        Width="1000"
        Height="600"
        MinWidth="700"
        MinHeight="400"
        Background="#F5F5F5">

    <Window.Resources>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="Black"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

    </Window.Resources>

    <Grid Margin="6">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.3*"/>
            <ColumnDefinition Width="1.3*"/>
            <ColumnDefinition Width="1.7*"/>
            <ColumnDefinition Width="1.7*"/>
        </Grid.ColumnDefinitions>

        <!-- ログファイル -->
        <GroupBox Grid.Column="0"
                  Header="ログファイル">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel x:Name="LogFilePanel"
                            Margin="6"/>

            </ScrollViewer>

        </GroupBox>

        <!-- 設定ファイル -->
        <GroupBox Grid.Column="1"
                  Header="設定ファイル">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel x:Name="ConfigFilePanel"
                            Margin="6"/>

            </ScrollViewer>

        </GroupBox>

        <!-- EXE -->
        <GroupBox Grid.Column="2"
                  Header="EXE">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel x:Name="ExePanel"
                            Margin="6"/>

            </ScrollViewer>

        </GroupBox>

        <!-- プロセス状態 -->
        <GroupBox Grid.Column="3"
                  Header="プロセス状態">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel x:Name="ProcessPanel"
                                Margin="6"/>

                </ScrollViewer>

                <Button Grid.Row="1"
                        Content="状態更新"
                        Height="32"
                        Margin="6,8,6,4"
                        Click="UpdateProcessButton_Click"/>

            </Grid>

        </GroupBox>

    </Grid>

</Window>